# DeepSeek 仅由服务端读取。复制为 .env.local 后填写真实密钥；不要提交 .env.local。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat 已于 2026-07-24 停用；当前官方 Chat Completions 模型名使用 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash
# 单次请求与一次分析（解析 + 可选解释）的服务端时限，均小于 Vercel Function 的 20 秒上限。
DEEPSEEK_TIMEOUT_MS=6500
DEEPSEEK_TOTAL_TIMEOUT_MS=16000

# 金融数据源适配器预留；当前没有接入，留空不会被描述为已连接。
FUYAO_API_BASE_URL=
FUYAO_API_KEY=
IFIND_MCP_URL=
IFIND_MCP_TOKEN=

# 金融快照来源文件可用性检查；不会把快照升级为实时或在线结构化数据。
FINANCIAL_SOURCE_VERIFY_TIMEOUT_MS=3500
FINANCIAL_CACHE_TTL_MS=900000

# Supabase Auth + Postgres。优先使用 2026 年的新 publishable key；legacy anon key 仅作兼容。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_MS=6000
